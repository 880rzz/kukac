{
  "name": "kukac-3d-arcade",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run check && npm run build && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "dev": "npm run build && wrangler dev --local",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kukac-arcade --local",
    "db:migrate:remote": "wrangler d1 migrations apply kukac-arcade --remote"
  },
  "devDependencies": {
    "wrangler": "^4.43.0"
  }
}
